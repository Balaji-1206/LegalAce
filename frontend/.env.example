# Development API Endpoints Configuration Template
# Web application running on local browser
EXPO_PUBLIC_API_URL_WEB=http://localhost:8000

# Mobile application running on Expo Go physical phone
# Update with your computer's LAN IP address (e.g. 192.168.1.50:8000 or 172.16.x.x:8000)
EXPO_PUBLIC_API_URL_MOBILE=http://<COMPUTER_LAN_IP>:8000
